<Style id="day10"><IconStyle><color>ff0055ff</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/10.png</href></Icon></IconStyle></Style>
<Style id="day11"><IconStyle><color>ffff5500</color><Icon><href>http://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle></Style>
